# Ollama only. No cloud API key is required.
# Default provider in code is ollama; this line is optional.
LLM_PROVIDER=ollama

# Replace with the model you have pulled, e.g. llama3.2 or qwen2.5
LLM_MODEL=llama3.2

# Optional. Defaults to http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434

# Optional. Defaults to data/projects.json
# PROJECTS_JSON_PATH=data/projects.json
